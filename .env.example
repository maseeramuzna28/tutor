# ==============================================================
# TUTO ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================

# Supabase (Database, Auth, RLS)
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are safe for the client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Only: Service Role Key for privileged operations (Points calculation, moderation admin)
# NEVER expose this to the browser or commit to git!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (Server-side AI Root-Cause Tutor)
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Optional Speech & Question Detection Providers
# Gradium API for high-fidelity speech services
GRADIUM_API_KEY=
GRADIUM_API_URL=https://api.gradium.ai/v1

# Jev API for Question Detection (fails open to true if absent)
JEV_API_KEY=
JEV_API_URL=https://api.jev.ai/v1

# Faculty Pulse Analytics
# Minimum doubt count per concept cluster before aggregating into "Other" (default: 3)
MIN_CLUSTER=3
